# Native PostgreSQL demo environment; copy to backend/.env for a NEW environment.
# Use the passwords you chose with createuser --pwprompt. Never commit real ones.
APP_ENV=development
APP_MASTER_KEY=
MODEL_EXECUTION_MODE=fixed_mock
PUBLISHING_EXECUTION_MODE=fixed_mock
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=geo_saas_demo
DB_USER=geo_app
DB_PASSWORD=replace-with-your-runtime-password
MIGRATION_DB_USER=geo_migrator
MIGRATION_DB_PASSWORD=replace-with-your-migration-password
STORAGE_ROOT=./data
API_READINESS_URL=http://127.0.0.1:8000/api/v1/health/ready
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TIMEOUT_SECONDS=20
