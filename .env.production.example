APP_VERSION=0.1.0
APP_ENV=production
APP_DOMAIN=geo.example.com
GEO_IMAGE_PREFIX=geo-saas

# 生成带正确填充的 URL-safe Base64 编码 32 字节随机值，禁止提交真实值。
GEO_APP_MASTER_KEY=replace-with-32-byte-urlsafe-base64
MODEL_EXECUTION_MODE=live

POSTGRES_DB=geo_saas
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-strong-admin-password
GEO_APP_USER=geo_app
GEO_APP_PASSWORD=replace-with-strong-runtime-password
GEO_MIGRATION_USER=geo_migrator
GEO_MIGRATION_PASSWORD=replace-with-strong-migration-password

# 只填写 age 公钥；私钥必须保存在主机安全目录，不能进入项目或容器镜像。
BACKUP_AGE_RECIPIENT=age1replace-with-backup-public-key
BACKUP_DAILY_RETENTION_DAYS=14
BACKUP_WEEKLY_RETENTION_DAYS=56
