# Host-native development only. Use with the db service + compose.dev.yaml.
# Root .env configures Compose; this file configures Python from backend/.
APP_ENV=development
APP_MASTER_KEY=
MODEL_EXECUTION_MODE=live
PUBLISHING_EXECUTION_MODE=live_browser
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=geo_saas
DB_USER=geo_app
DB_PASSWORD=geo_app_dev
MIGRATION_DB_USER=geo_migrator
MIGRATION_DB_PASSWORD=geo_migrator_dev
STORAGE_ROOT=./data
API_READINESS_URL=http://127.0.0.1:8000/api/v1/health/ready
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TIMEOUT_SECONDS=20
# Optional: absolute path to the Chrome/Edge executable on this machine.
# BROWSER_EXECUTABLE_PATH=
