APP_VERSION=0.1.0
APP_ENV=development
# 生产环境必填：URL-safe Base64 编码的 32 字节随机值，不要提交真实值
GEO_APP_MASTER_KEY=
MODEL_EXECUTION_MODE=live
WEB_PORT=5173
POSTGRES_DB=geo_saas
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev
GEO_APP_USER=geo_app
GEO_APP_PASSWORD=geo_app_dev
GEO_MIGRATION_USER=geo_migrator
GEO_MIGRATION_PASSWORD=geo_migrator_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geo_saas
DB_USER=geo_app
DB_PASSWORD=geo_app_dev
MIGRATION_DB_USER=geo_migrator
MIGRATION_DB_PASSWORD=geo_migrator_dev
STORAGE_ROOT=./backend/data
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_TIMEOUT_SECONDS=20
