FROM golang:1.26.4-alpine3.24@sha256:3ad57304ad93bbec8548a0437ad9e06a455660655d9af011d58b993f6f615648 AS tool-builder

RUN apk add --no-cache git

RUN git clone --depth 1 --branch v1.3.1 https://github.com/FiloSottile/age.git /src/age \
    && cd /src/age \
    && go get golang.org/x/crypto@v0.52.0 golang.org/x/net@v0.55.0 \
    && go mod tidy \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/age ./cmd/age \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/age-keygen ./cmd/age-keygen

FROM postgres:18-alpine@sha256:9a8afca54e7861fd90fab5fdf4c42477a6b1cb7d293595148e674e0a3181de15 AS runtime-root

RUN apk upgrade --no-cache \
    && apk add --no-cache \
    bash \
    coreutils \
    findutils \
    tar \
    && rm -f /usr/local/bin/gosu

FROM scratch

COPY --from=runtime-root / /
ENV PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    LANG="en_US.utf8" \
    PG_MAJOR="18" \
    PG_VERSION="18.4" \
    PGDATA="/var/lib/postgresql/18/docker"

COPY --from=tool-builder /out/age /usr/local/bin/age
COPY --from=tool-builder /out/age-keygen /usr/local/bin/age-keygen
COPY ops/backup.sh /usr/local/bin/geo-backup
COPY ops/restore.sh /usr/local/bin/geo-restore
COPY ops/backup-crontab /etc/crontabs/root

RUN chmod 0755 /usr/local/bin/geo-backup /usr/local/bin/geo-restore \
    && chmod 0600 /etc/crontabs/root

ENTRYPOINT ["crond", "-f", "-l", "2"]
