FROM golang:1.26.4-alpine3.24@sha256:3ad57304ad93bbec8548a0437ad9e06a455660655d9af011d58b993f6f615648 AS builder

RUN apk add --no-cache git
RUN git clone --depth 1 --branch v2.11.4 https://github.com/caddyserver/caddy.git /src/caddy \
    && cd /src/caddy/cmd/caddy \
    && go get \
      golang.org/x/crypto@v0.52.0 \
      golang.org/x/net@v0.55.0 \
      google.golang.org/grpc@v1.82.1 \
      go.opentelemetry.io/otel@v1.43.0 \
      go.opentelemetry.io/otel/sdk@v1.43.0 \
      go.opentelemetry.io/otel/sdk/metric@v1.43.0 \
      github.com/smallstep/certificates@v0.30.0 \
      github.com/quic-go/quic-go@v0.59.0 \
      github.com/slackhq/nebula@v1.10.3 \
      github.com/go-jose/go-jose/v4@v4.1.4 \
      github.com/go-jose/go-jose/v3@v3.0.5 \
    && go mod tidy \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/caddy .

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates \
    && mkdir -p /config/caddy /data/caddy /etc/caddy

COPY --from=builder /out/caddy /usr/bin/caddy

ENV XDG_CONFIG_HOME="/config" \
    XDG_DATA_HOME="/data"

EXPOSE 80 443 443/udp
ENTRYPOINT ["caddy"]
CMD ["run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
