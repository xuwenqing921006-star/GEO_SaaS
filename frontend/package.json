{
  "name": "@geo-saas/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e:t008": "playwright test --config e2e/t008.playwright.config.ts",
    "test:e2e:t009": "playwright test --config e2e/t009.playwright.config.ts",
    "test:e2e:t010": "playwright test --config e2e/t010.playwright.config.ts",
    "test:e2e:t011": "playwright test --config e2e/t011.playwright.config.ts",
    "test:e2e:t012": "playwright test --config e2e/t012.playwright.config.ts",
    "test:e2e:t013": "playwright test --config e2e/t013.playwright.config.ts",
    "test:e2e:t016": "playwright test --config e2e/t016.playwright.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts --output=e2e/.playwright-results",
    "test:e2e:t003": "playwright test --config=e2e/t003.playwright.config.ts --output=e2e/.playwright-results",
    "test:e2e:t004": "playwright test --config=e2e/t004.playwright.config.ts --output=e2e/.playwright-results",
    "test:e2e:t005": "playwright test --config=e2e/t005.playwright.config.ts --output=e2e/.playwright-results",
    "test:e2e:t007": "playwright test --config=e2e/t007.playwright.config.ts --output=e2e/.playwright-results",
    "test:build-security": "vite build --mode production --outDir node_modules/.t002-production-build && node e2e/assert-production-build.mjs",
    "build": "vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.101.4",
    "ant-design-vue": "4.2.6",
    "pinia": "3.0.4",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@testing-library/vue": "8.1.0",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "happy-dom": "20.11.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.8"
  }
}
